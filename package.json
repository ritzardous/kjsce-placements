{
  "name": "placementstats-kjsce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-live.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run data:linkedin && npm run build:functions && npm run typecheck && vite build",
    "predev": "npm run data:linkedin && npm run build:functions",
    "predev:api": "npm run build:functions",
    "start": "vite preview --host 127.0.0.1",
    "db:seed": "tsx scripts/seed-firestore.ts",
    "db:verify": "tsx scripts/verify-firestore.ts",
    "auth:set-role": "tsx scripts/set-role.ts",
    "test:firebase": "node scripts/test-firebase.mjs",
    "build:functions": "npm --prefix functions run build",
    "procedures:seed": "tsx scripts/seed-procedure-companies.ts",
    "cloud:firebase": "node scripts/cloud-firebase.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:rules": "tsx scripts/deploy-rules.ts",
    "auth:verify": "tsx scripts/verify-auth.ts",
    "data:build-2025": "tsx scripts/build-2025-dataset.ts",
    "data:build-2027": "tsx scripts/build-2027-dataset.ts",
    "dev:beta": "node scripts/dev-beta.mjs",
    "procedures:deploy": "node scripts/deploy-procedures.mjs",
    "procedures:verify": "tsx scripts/verify-procedures.ts",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "data:linkedin": "tsx scripts/build-linkedin.ts",
    "predev:web": "npm run data:linkedin"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.32.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "@grpc/grpc-js": "1.14.5",
    "@opentelemetry/core": "2.12.0",
    "basic-ftp": "6.2.2",
    "firebase-tools": {
      "chokidar": "4.0.3"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@firebase/app-compat": "0.5.19",
    "@firebase/app": "0.16.3"
  }
}
