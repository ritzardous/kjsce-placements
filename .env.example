VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# false for your real Firebase project; true only with a demo- project ID locally.
VITE_USE_FIREBASE_EMULATORS=false
# Optional analytics property; only loaded in production.
VITE_GA_ID=
# Private local CLI credentials ONLY. Never prefix this with VITE_ or deploy it to Vercel.
GOOGLE_APPLICATION_CREDENTIALS=

# Server/API hosting only: existing administrator UIDs allowed to assign roles.
# Comma separated; never prefix with VITE_. Configure Functions separately if used.
ADMIN_OWNER_UIDS=
# Production HTTP API runtime only (for example, Vercel server environment).
# Do not give these names a VITE_ prefix. Use hosting secrets for the private JSON.
FIREBASE_PROJECT_ID=your-project-id
# Full private service-account JSON goes in the server hosting secret, not Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
