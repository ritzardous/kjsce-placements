rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function active(year, version) {
      return get(/databases/$(database)/documents/batches/$(year)).data.activeVersion == version;
    }
    match /batches/{year} {
      allow get: if googleUser();
      allow list, write: if false;
      match /versions/{version} {
        allow get: if googleUser() && active(year, version);
        allow list, write: if false;
        match /views/{view} {
          allow get: if googleUser() && active(year, version) && view.matches('chunk-[0-9]{4}');
          allow list, write: if false;
        }
      }
    }
    match /users/{uid} {
      allow get: if googleUser() && request.auth.uid == uid;
      allow create: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow update: if googleUser() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow list, delete: if false;
    }
    function procedureAdmin() { return googleUser() && request.auth.token.role == 'admin'; }
    match /procedureCompanies/{company} { allow read: if googleUser(); allow write: if false; }
    match /procedurePreferences/{uid} { allow get: if googleUser() && request.auth.uid == uid; allow list, write: if false; }
    match /procedureBookmarks/{uid}/items/{id} { allow read: if googleUser() && request.auth.uid == uid; allow write: if false; }
    match /procedureNotifications/{uid}/items/{id} { allow read: if googleUser() && request.auth.uid == uid; allow write: if false; }
    match /procedureQuestions/{id} {
      // API reads remove pending answers; clients cannot read discussion documents.
      allow read: if procedureAdmin();
      allow write: if false;
    }
    match /procedureReports/{id} { allow read: if procedureAdmin(); allow write: if false; }
    match /procedureSubmissions/{id} {
      allow read: if googleUser() && (resource.data.ownerUid == request.auth.uid || procedureAdmin());
      allow write: if false;
      match /revisions/{revision} {
        allow read: if googleUser() && (get(/databases/$(database)/documents/procedureSubmissions/$(id)).data.ownerUid == request.auth.uid || procedureAdmin());
        allow write: if false;
      }
    }
    match /procedurePosts/{id} {
      allow read: if googleUser() && (resource.data.published == true || procedureAdmin());
      allow write: if false;
      match /votes/{uid} {
        allow read: if googleUser() && (uid == request.auth.uid || procedureAdmin())
          && get(/databases/$(database)/documents/procedurePosts/$(id)).data.published == true;
        allow write: if false;
      }
    }
    match /procedureModeration/{eventId} { allow read: if procedureAdmin(); allow write: if false; }
    // Imports, email delivery state, rate limits and role assignment stay private.
    match /{document=**} { allow read, write: if false; }
  }
}
